// envoui.edit: typing, line breaks with indentation, deleting, moving (by character, word,
// line with a goal column, home), several cursors, undo and redo, and CRLF kept.
// expect: typed: hello world|
// expect: newline: fn {|    x|    }|
// expect: backspace: fn {|    x}|
// expect: undo 1: fn {|    x|}|
// expect: undo 2: hello |
// expect: undo 3: |
// expect: redo: hello world|
// expect: moves: 0:5 0:6 1:4 0:6 0:0 0:2
// expect: multi: a1 b1 c1|
// expect: multi undo: a b c|
// expect: crlf: true one\r\ntwo!\r\n
// expect: utf8: é→ 2 0:2 0:0
use envoui.edit;
use alloc.text;

// The text with "|" for line breaks.
void Show(str label, in edit.Buffer b) {
    string t = text.Replace(b.Text().AsStr(), "\n", "|");
    write(1, label);
    write(1, ": ");
    write(1, t.AsStr());
    print("|");
}

void Say(str a, str b, str c) {
    write(1, a);
    write(1, b);
    print(c);
}

string At(edit.Pos p) {
    string s = text.Uint(p.Line as u64);
    s.Append(":");
    s.Append(text.Uint(p.Col as u64).AsStr());
    return s;
}

// typing: one character at a time joins one undo step; a space starts a new one
edit.Buffer b = edit.Buffer.New();
str hello = "hello";
for (usize i = 0; i < hello.Len; i++) b.Insert(hello[i..i + 1]);
b.Insert(" ");
b.Insert("world");
Show("typed", b);

// newline keeps indentation
edit.Buffer f = edit.Buffer.Of("fn {}");
f.SetCursor(edit.Pos.At(0, 4));
f.Newline();
f.Insert("    x");
f.Newline();
Show("newline", f);
f.Backspace();
f.Backspace();
Show("backspace", f);
f.Undo();
Show("undo 1", f);

b.Undo();
Show("undo 2", b);
b.Undo();
b.Undo();
Show("undo 3", b);
b.Redo();
b.Redo();
b.Redo();
Show("redo", b);

// moving
edit.Buffer m = edit.Buffer.Of("hello world\n  ab\nlonger line");
m.SetCursor(edit.Pos.At(0, 0));
string moves = string.New();
m.Move(edit.MOVE_WORD_RIGHT, false, 0);
moves.Append(At(m.Cursor()).AsStr());
m.Move(edit.MOVE_RIGHT, false, 0);
moves.Append(" ");
moves.Append(At(m.Cursor()).AsStr());
m.Move(edit.MOVE_DOWN, false, 0);           // line 1 is shorter: its end
moves.Append(" ");
moves.Append(At(m.Cursor()).AsStr());
m.Move(edit.MOVE_UP, false, 0);             // back to the goal column
moves.Append(" ");
moves.Append(At(m.Cursor()).AsStr());
m.Move(edit.MOVE_HOME, false, 0);
moves.Append(" ");
moves.Append(At(m.Cursor()).AsStr());
m.SetCursor(edit.Pos.At(1, 0));
m.Move(edit.MOVE_HOME, false, 0);           // to the indentation
m.Move(edit.MOVE_UP, false, 0);
moves.Append(" ");
moves.Append(At(m.Cursor()).AsStr());
Say("moves: ", moves.AsStr(), "");

// several cursors type at once and undo together
edit.Buffer k = edit.Buffer.Of("a\nb\nc");
k.SetCursor(edit.Pos.At(0, 1));
k.AddCursor(edit.Pos.At(1, 1));
k.AddCursor(edit.Pos.At(2, 1));
k.Insert("1");
string mt = text.Replace(k.Text().AsStr(), "\n", " ");
Say("multi: ", mt.AsStr(), "|");
k.Undo();
string mu = text.Replace(k.Text().AsStr(), "\n", " ");
Say("multi undo: ", mu.AsStr(), "|");

// CRLF in, CRLF out
edit.Buffer w = edit.Buffer.Of("one\r\ntwo\r\n");
w.SetCursor(edit.Pos.At(1, 3));
w.Insert("!");
string wt = text.Replace(text.Replace(w.Text().AsStr(), "\r", "\\r").AsStr(), "\n", "\\n");
if (w.UsesCrlf()) Say("crlf: true ", wt.AsStr(), "");
else Say("crlf: false ", wt.AsStr(), "");

// movement steps over whole characters
edit.Buffer u = edit.Buffer.Of("é→");
u.SetCursor(edit.Pos.At(0, 0));
u.Move(edit.MOVE_RIGHT, false, 0);
string us = string.From(u.Line(0));
us.Append(" ");
us.Append(text.Uint(u.VisualCol(edit.Pos.At(0, 5)) as u64).AsStr());
us.Append(" ");
us.Append(At(u.Cursor()).AsStr());
u.Move(edit.MOVE_LEFT, false, 0);
us.Append(" ");
us.Append(At(u.Cursor()).AsStr());
Say("utf8: ", us.AsStr(), "");

// envoui.term: terminal programs (PLAN D43). Styles as VT sequences, a decoder that turns
// the bytes a terminal sends into keys, and a screen of cells that draws only what
// changed since the last frame. The Terminal port (ports.ITerminal) carries the bytes;
// everything here is pure, so it is tested by comparing the text it produces.
namespace envoui.term;

use ports.{ITerminal};
use alloc.text;

// ------------------------------------------------------------------ styles

const u32 SET = 0x1000000;         // a color's flag: set (else the terminal's own)
const u8 BOLD = 1;
const u8 UNDERLINE = 2;
const u8 REVERSE = 4;
const u8 DIM = 8;
const u8 ITALIC = 16;

// How a cell is drawn: foreground and background colors (24-bit, or the terminal's
// own), and bold, dim, italic, underline, reverse.
public struct Style {
    u32 Fore;
    u32 Back;
    u8 Attrs;

    // The terminal's own colors, nothing else.
    public static Style Plain() => new Style { Fore = 0, Back = 0, Attrs = 0 };

    public Style Fg(in this, u32 rgb) => new Style { Fore = rgb & 0xFFFFFF | SET, Back = this.Back, Attrs = this.Attrs };
    public Style Bg(in this, u32 rgb) => new Style { Fore = this.Fore, Back = rgb & 0xFFFFFF | SET, Attrs = this.Attrs };
    public Style Bold(in this) => this.With(BOLD);
    public Style Dim(in this) => this.With(DIM);
    public Style Italic(in this) => this.With(ITALIC);
    public Style Underline(in this) => this.With(UNDERLINE);
    public Style Reverse(in this) => this.With(REVERSE);

    Style With(in this, u8 attr) => new Style { Fore = this.Fore, Back = this.Back, Attrs = this.Attrs | attr };

    public bool Same(in this, in Style other) => this.Fore == other.Fore && this.Back == other.Back && this.Attrs == other.Attrs;
    public bool IsPlain(in this) => this.Fore == 0 && this.Back == 0 && this.Attrs == 0;

    // The SGR sequence that sets exactly this style (it resets first).
    public string Sgr(in this) {
        string s = string.New();
        Csi(ref s);
        s.AppendByte('0');
        if (this.Attrs & BOLD != 0) s.Append(";1");
        if (this.Attrs & DIM != 0) s.Append(";2");
        if (this.Attrs & ITALIC != 0) s.Append(";3");
        if (this.Attrs & UNDERLINE != 0) s.Append(";4");
        if (this.Attrs & REVERSE != 0) s.Append(";7");
        if (this.Fore & SET != 0) Rgb(ref s, "38", this.Fore);
        if (this.Back & SET != 0) Rgb(ref s, "48", this.Back);
        s.AppendByte('m');
        return s;
    }
}

void Csi(ref string s) {
    s.AppendByte(27);
    s.AppendByte('[');
}

void Num(ref string s, u64 n) => s.Append(text.Uint(n).AsStr());

void Rgb(ref string s, str which, u32 c) {
    s.AppendByte(';');
    s.Append(which);
    s.Append(";2;");
    Num(ref s, (c >> 16 & 0xFF) as u64);
    s.AppendByte(';');
    Num(ref s, (c >> 8 & 0xFF) as u64);
    s.AppendByte(';');
    Num(ref s, (c & 0xFF) as u64);
}

// text in style s, then the terminal's own style again: for output that is not a screen.
public string Styled(str t, in Style s) {
    string r = s.Sgr();
    r.Append(t);
    Csi(ref r);
    r.Append("0m");
    return r;
}

// The cursor to column col and row row, counted from 0 at the top left.
public string MoveTo(u32 col, u32 row) {
    string s = string.New();
    Csi(ref s);
    Num(ref s, row as u64 + 1);
    s.AppendByte(';');
    Num(ref s, col as u64 + 1);
    s.AppendByte('H');
    return s;
}

string Seq(str rest) {
    string s = string.New();
    Csi(ref s);
    s.Append(rest);
    return s;
}

public string ClearScreen() => Seq("2J");
public string HideCursor() => Seq("?25l");
public string ShowCursor() => Seq("?25h");
// The alternate screen: a full-screen program draws there, and the shell's text is back
// when it leaves.
public string EnterAltScreen() => Seq("?1049h");
public string LeaveAltScreen() => Seq("?1049l");

// ------------------------------------------------------------------ keys

// What a key is.
public enum KeyKind {
    Char,           // a character: Code is its code point
    Enter,
    Tab,
    BackTab,        // Shift+Tab
    Backspace,
    Escape,
    Up,
    Down,
    Left,
    Right,
    Home,
    End,
    PageUp,
    PageDown,
    Insert,
    Delete,
    Function,       // F1-F12: Code is the number
}

const u8 CTRL = 1;
const u8 ALT = 2;
const u8 SHIFT = 4;

// A key pressed, with Ctrl, Alt and Shift where the terminal tells them.
public struct Key {
    KeyKind K;
    u32 Code;
    u8 Mods;

    public static Key Of(KeyKind k) => new Key { K = k, Code = 0, Mods = 0 };
    public static Key Character(u32 c) => new Key { K = KeyKind.Char, Code = c, Mods = 0 };

    public KeyKind Kind(in this) => this.K;
    // The character (KeyKind.Char) or function key number (KeyKind.Function).
    public u32 Char(in this) => this.Code;
    public bool Ctrl(in this) => this.Mods & CTRL != 0;
    public bool Alt(in this) => this.Mods & ALT != 0;
    public bool Shift(in this) => this.Mods & SHIFT != 0;

    public bool Is(in this, KeyKind k) => this.K == k;
    // Is this the character c, with no Ctrl or Alt?
    public bool IsChar(in this, u32 c) => this.K == KeyKind.Char && this.Code == c && this.Mods & (CTRL | ALT) == 0;
    // Is this Ctrl and the letter c ('a' to 'z')?
    public bool IsCtrl(in this, u32 c) => this.K == KeyKind.Char && this.Code == c && this.Mods & CTRL != 0;

    // A name for the key: "a", "Ctrl+C", "Alt+Up", "F5", "Enter".
    public string Name(in this) {
        string s = string.New();
        if (this.Mods & CTRL != 0) s.Append("Ctrl+");
        if (this.Mods & ALT != 0) s.Append("Alt+");
        if (this.Mods & SHIFT != 0) s.Append("Shift+");
        if (this.K == KeyKind.Char) {
            if (this.Code == ' ' as u32) s.Append("Space");
            else if (this.Mods & CTRL != 0 && this.Code >= 'a' as u32 && this.Code <= 'z' as u32) s.AppendByte((this.Code - 32) as u8);
            else Utf8(ref s, this.Code);
        } else if (this.K == KeyKind.Function) {
            s.AppendByte('F');
            Num(ref s, this.Code as u64);
        } else {
            s.Append(KindName(this.K));
        }
        return s;
    }

    Key WithMods(in this, u8 m) => new Key { K = this.K, Code = this.Code, Mods = this.Mods | m };
}

str KindName(KeyKind k) {
    if (k == KeyKind.Enter) return "Enter";
    if (k == KeyKind.Tab) return "Tab";
    if (k == KeyKind.BackTab) return "BackTab";
    if (k == KeyKind.Backspace) return "Backspace";
    if (k == KeyKind.Escape) return "Escape";
    if (k == KeyKind.Up) return "Up";
    if (k == KeyKind.Down) return "Down";
    if (k == KeyKind.Left) return "Left";
    if (k == KeyKind.Right) return "Right";
    if (k == KeyKind.Home) return "Home";
    if (k == KeyKind.End) return "End";
    if (k == KeyKind.PageUp) return "PageUp";
    if (k == KeyKind.PageDown) return "PageDown";
    if (k == KeyKind.Insert) return "Insert";
    if (k == KeyKind.Delete) return "Delete";
    return "Char";
}

// Code point c as UTF-8.
void Utf8(ref string s, u32 c) {
    if (c < 0x80) {
        s.AppendByte(c as u8);
    } else if (c < 0x800) {
        s.AppendByte((0xC0 | c >> 6) as u8);
        s.AppendByte((0x80 | c & 0x3F) as u8);
    } else if (c < 0x10000) {
        s.AppendByte((0xE0 | c >> 12) as u8);
        s.AppendByte((0x80 | c >> 6 & 0x3F) as u8);
        s.AppendByte((0x80 | c & 0x3F) as u8);
    } else {
        s.AppendByte((0xF0 | c >> 18) as u8);
        s.AppendByte((0x80 | c >> 12 & 0x3F) as u8);
        s.AppendByte((0x80 | c >> 6 & 0x3F) as u8);
        s.AppendByte((0x80 | c & 0x3F) as u8);
    }
}

// The length of the UTF-8 sequence lead starts; 1 for a byte that starts none.
usize Utf8Len(u8 lead) {
    if (lead >= 0xF0 && lead < 0xF8) return 4;
    if (lead >= 0xE0) return 3;
    if (lead >= 0xC0) return 2;
    return 1;
}

// The code point of the UTF-8 sequence of n bytes at b[at]; U+FFFD if it is not one.
u32 Decode(u8[] b, usize at, usize n) {
    if (n == 1) {
        if (b[at] < 0x80) return b[at] as u32;
        return 0xFFFD;
    }
    u32 c = 0;
    if (n == 2) c = (b[at] & 0x1F) as u32;
    if (n == 3) c = (b[at] & 0x0F) as u32;
    if (n == 4) c = (b[at] & 0x07) as u32;
    for (usize i = 1; i < n; i++) {
        if (b[at + i] & 0xC0 != 0x80) return 0xFFFD;
        c = c << 6 | (b[at + i] & 0x3F) as u32;
    }
    return c;
}

// Decode for text.
u32 DecodeText(str b, usize at, usize n) {
    if (n == 1) {
        if (b[at] < 0x80) return b[at] as u32;
        return 0xFFFD;
    }
    u32 c = 0;
    if (n == 2) c = (b[at] & 0x1F) as u32;
    if (n == 3) c = (b[at] & 0x0F) as u32;
    if (n == 4) c = (b[at] & 0x07) as u32;
    for (usize i = 1; i < n; i++) {
        if (b[at + i] & 0xC0 != 0x80) return 0xFFFD;
        c = c << 6 | (b[at + i] & 0x3F) as u32;
    }
    return c;
}

// Turns the bytes a terminal sends into keys. Escape sequences may arrive split, so a
// lone Escape at the end waits for more unless the caller says nothing more is coming.
public struct Keys {
    List<u8> Buf;
    usize At;

    public static Keys New() => new Keys { Buf = List<u8>.New(), At = 0 };

    // More bytes from the terminal.
    public void Feed(ref this, u8[] bytes) {
        if (this.At > 0 && this.At == this.Buf.Len()) {
            this.Buf = List<u8>.New();
            this.At = 0;
        }
        for (usize i = 0; i < bytes.Len; i++) this.Buf.Push(bytes[i]);
    }

    public void FeedText(ref this, str t) {
        for (usize i = 0; i < t.Len; i++) this.Buf.Push(t[i]);
    }

    // The next whole key, if there is one. final: no more bytes are coming soon, so an
    // Escape at the end is the Escape key, not the start of a sequence.
    public Key? Next(ref this, bool final) {
        u8[] b = this.Buf.AsSlice();
        usize at = this.At;
        if (at >= b.Len) return null;
        u8 c = b[at];
        if (c == 27) {
            if (at + 1 >= b.Len) {
                if (!final) return null;
                this.At = at + 1;
                return Some(Key.Of(KeyKind.Escape));
            }
            u8 d = b[at + 1];
            if (d == '[' || d == 'O') {
                // CSI or SS3: parameters, then a final byte
                usize i = at + 2;
                u32 p1 = 0;
                u32 p2 = 0;
                u32 which = 1;
                while (i < b.Len && (b[i] >= '0' && b[i] <= '9' || b[i] == ';')) {
                    if (b[i] == ';') which++;
                    else if (which == 1) p1 = p1 * 10 + (b[i] - '0') as u32;
                    else p2 = p2 * 10 + (b[i] - '0') as u32;
                    i++;
                }
                if (i >= b.Len) {
                    if (!final) return null;
                    this.At = b.Len;
                    return Some(Key.Of(KeyKind.Escape));
                }
                this.At = i + 1;
                Key k = Sequence(b[i], p1);
                if (p2 >= 2) {
                    // xterm's modifier parameter: 1 + Shift(1) + Alt(2) + Ctrl(4)
                    u32 m = p2 - 1;
                    u8 mods = 0;
                    if (m & 1 != 0) mods = mods | SHIFT;
                    if (m & 2 != 0) mods = mods | ALT;
                    if (m & 4 != 0) mods = mods | CTRL;
                    k = k.WithMods(mods);
                }
                return Some(k);
            }
            // Alt and a key: Escape, then the key
            this.At = at + 1;
            Key? rest = this.Next(final);
            if (rest.IsNone()) {
                this.At = at;
                return null;
            }
            return Some(rest.Unwrap().WithMods(ALT));
        }
        if (c >= 0x80) {
            usize n = Utf8Len(c);
            if (at + n > b.Len) {
                if (!final) return null;
                n = b.Len - at;
            }
            this.At = at + n;
            return Some(Key.Character(Decode(b, at, n)));
        }
        this.At = at + 1;
        if (c == 13 || c == 10) return Some(Key.Of(KeyKind.Enter));
        if (c == 9) return Some(Key.Of(KeyKind.Tab));
        if (c == 127 || c == 8) return Some(Key.Of(KeyKind.Backspace));
        if (c == 0) return Some(Key.Character(' ' as u32).WithMods(CTRL));
        if (c < 27) return Some(Key.Character('a' as u32 + c as u32 - 1).WithMods(CTRL));
        if (c < 32) return Some(Key.Character('4' as u32 + c as u32 - 28).WithMods(CTRL));
        return Some(Key.Character(c as u32));
    }
}

// The key a CSI or SS3 sequence ending in final names, with its first parameter p.
Key Sequence(u8 final, u32 p) {
    if (final == 'A') return Key.Of(KeyKind.Up);
    if (final == 'B') return Key.Of(KeyKind.Down);
    if (final == 'C') return Key.Of(KeyKind.Right);
    if (final == 'D') return Key.Of(KeyKind.Left);
    if (final == 'H') return Key.Of(KeyKind.Home);
    if (final == 'F') return Key.Of(KeyKind.End);
    if (final == 'Z') return Key.Of(KeyKind.BackTab);
    if (final >= 'P' && final <= 'S') return Function((final - 'P') as u32 + 1);
    if (final == '~') {
        if (p == 1 || p == 7) return Key.Of(KeyKind.Home);
        if (p == 4 || p == 8) return Key.Of(KeyKind.End);
        if (p == 2) return Key.Of(KeyKind.Insert);
        if (p == 3) return Key.Of(KeyKind.Delete);
        if (p == 5) return Key.Of(KeyKind.PageUp);
        if (p == 6) return Key.Of(KeyKind.PageDown);
        if (p >= 11 && p <= 15) return Function(p - 10);
        if (p >= 17 && p <= 21) return Function(p - 11);
        if (p == 23 || p == 24) return Function(p - 12);
    }
    return Key.Of(KeyKind.Escape);
}

Key Function(u32 n) => new Key { K = KeyKind.Function, Code = n, Mods = 0 };

// The next key from the terminal, waiting at most waitMs milliseconds (negative: as long
// as it takes); None if no key came.
public Key? ReadKey<T>(ref T t, ref Keys keys, i32 waitMs) where T : ITerminal {
    Key? first = keys.Next(false);
    if (first.IsSome()) return first;
    u8[64] buf;
    usize n = t.Read(buf[0..64], waitMs);
    if (n == 0) return keys.Next(true);
    keys.Feed(buf[0..n]);
    Key? k = keys.Next(false);
    if (k.IsSome()) return k;
    // the rest of an escape sequence is on its way, or this was the Escape key
    usize more = t.Read(buf[0..64], 30);
    if (more > 0) keys.Feed(buf[0..more]);
    return keys.Next(more == 0);
}

// ------------------------------------------------------------------ screen

// One cell: a character and its style.
struct Cell {
    u32 Ch;
    u32 Fore;
    u32 Back;
    u8 Attrs;
}

bool SameCell(in Cell a, in Cell b) => a.Ch == b.Ch && a.Fore == b.Fore && a.Back == b.Back && a.Attrs == b.Attrs;

Cell Blank() => new Cell { Ch = ' ' as u32, Fore = 0, Back = 0, Attrs = 0 };

// A grid of cells, cols x rows. Draw into it, then Render gives the text that brings the
// terminal from the last frame to this one: only the cells that changed, the first frame
// (and the first after Resize or Invalidate) in full. Each code point takes one cell.
public struct Screen {
    u32 C;
    u32 R;
    List<Cell> Cells;
    List<Cell> Shown;       // what the terminal has, after the last Render
    bool Full;              // the next Render redraws everything
    u32 CX0;                // the clip: drawing lands only in [CX0, CX1) x [CY0, CY1)
    u32 CY0;
    u32 CX1;
    u32 CY1;

    public static Screen New(u32 cols, u32 rows) {
        Screen s = new Screen {
            C = cols, R = rows, Cells = List<Cell>.New(), Shown = List<Cell>.New(), Full = true,
            CX0 = 0, CY0 = 0, CX1 = cols, CY1 = rows
        };
        for (u32 i = 0; i < cols * rows; i++) {
            s.Cells.Push(Blank());
            s.Shown.Push(Blank());
        }
        return s;
    }

    public u32 Cols(in this) => this.C;
    public u32 Rows(in this) => this.R;

    // A new size: the cells are cleared, the clip reset and the next frame drawn in full.
    public void Resize(ref this, u32 cols, u32 rows) {
        this.C = cols;
        this.R = rows;
        this.ResetClip();
        this.Cells = List<Cell>.New();
        this.Shown = List<Cell>.New();
        for (u32 i = 0; i < cols * rows; i++) {
            this.Cells.Push(Blank());
            this.Shown.Push(Blank());
        }
        this.Full = true;
    }

    // The next frame is drawn in full (after something else wrote to the terminal).
    public void Invalidate(ref this) {
        this.Full = true;
    }

    // Every cell blank, in the terminal's own style.
    public void Clear(ref this) {
        for (u32 i = 0; i < this.C * this.R; i++) this.Cells.Set(i as usize, Blank());
    }

    // The character at (col, row); 0 outside the screen.
    public u32 CharAt(in this, u32 col, u32 row) {
        if (col >= this.C || row >= this.R) return 0;
        return this.Cells.Get((row * this.C + col) as usize).Ch;
    }

    // Drawing lands only inside the w x h rectangle at (col, row) (and the screen) until
    // the next SetClip or ResetClip. Clear ignores the clip.
    public void SetClip(ref this, u32 col, u32 row, u32 w, u32 h) {
        this.CX0 = col;
        this.CY0 = row;
        this.CX1 = col + w;
        this.CY1 = row + h;
        if (this.CX1 > this.C) this.CX1 = this.C;
        if (this.CY1 > this.R) this.CY1 = this.R;
    }

    public void ResetClip(ref this) => this.SetClip(0, 0, this.C, this.R);

    // Code point ch in style s at (col, row); nothing outside the screen or the clip.
    public void Set(ref this, u32 col, u32 row, u32 ch, in Style s) {
        if (col < this.CX0 || row < this.CY0 || col >= this.CX1 || row >= this.CY1) return;
        this.Cells.Set((row * this.C + col) as usize, new Cell { Ch = ch, Fore = s.Fore, Back = s.Back, Attrs = s.Attrs });
    }

    // text from (col, row) to the right, cut at the edge. Returns the column after it.
    public u32 Put(ref this, u32 col, u32 row, str t, in Style s) {
        u32 x = col;
        usize i = 0;
        while (i < t.Len) {
            usize n = Utf8Len(t[i]);
            if (i + n > t.Len) n = t.Len - i;
            u32 c = DecodeText(t, i, n);
            i += n;
            if (c == 10 || c == 13) continue;
            this.Set(x, row, c, s);
            x++;
        }
        return x;
    }

    // A w x h rectangle of ch in style s.
    public void Fill(ref this, u32 col, u32 row, u32 w, u32 h, u32 ch, in Style s) {
        for (u32 y = row; y < row + h; y++) {
            for (u32 x = col; x < col + w; x++) this.Set(x, y, ch, s);
        }
    }

    // A box of light lines around the w x h rectangle at (col, row).
    public void Box(ref this, u32 col, u32 row, u32 w, u32 h, in Style s) {
        if (w < 2 || h < 2) return;
        u32 right = col + w - 1;
        u32 bottom = row + h - 1;
        for (u32 x = col + 1; x < right; x++) {
            this.Set(x, row, 0x2500, s);
            this.Set(x, bottom, 0x2500, s);
        }
        for (u32 y = row + 1; y < bottom; y++) {
            this.Set(col, y, 0x2502, s);
            this.Set(right, y, 0x2502, s);
        }
        this.Set(col, row, 0x250C, s);
        this.Set(right, row, 0x2510, s);
        this.Set(col, bottom, 0x2514, s);
        this.Set(right, bottom, 0x2518, s);
    }

    // The text that brings the terminal from the last frame to this one.
    public string Render(ref this) {
        string s = string.New();
        bool full = this.Full;
        if (full) {
            Csi(ref s);
            s.Append("0m");
            Csi(ref s);
            s.Append("2J");
        }
        Cell[] cells = this.Cells.AsSlice();
        Cell[] shown = this.Shown.AsSlice();
        Style cur = Style.Plain();
        bool known = false;     // where the cursor is
        u32 cx = 0;
        u32 cy = 0;
        for (u32 y = 0; y < this.R; y++) {
            for (u32 x = 0; x < this.C; x++) {
                usize i = (y * this.C + x) as usize;
                if (full) {
                    if (SameCell(cells[i], Blank())) continue;
                } else if (SameCell(cells[i], shown[i])) {
                    continue;
                }
                if (!known || cx != x || cy != y) {
                    s.Append(MoveTo(x, y).AsStr());
                }
                Style want = new Style { Fore = cells[i].Fore, Back = cells[i].Back, Attrs = cells[i].Attrs };
                if (!want.Same(cur)) {
                    s.Append(want.Sgr().AsStr());
                    cur = want;
                }
                Utf8(ref s, cells[i].Ch);
                // past the last column the cursor waits to wrap: move it explicitly
                known = x + 1 < this.C;
                cx = x + 1;
                cy = y;
            }
        }
        if (!cur.IsPlain()) {
            Csi(ref s);
            s.Append("0m");
        }
        List<Cell> copy = List<Cell>.New();
        for (usize i = 0; i < cells.Len; i++) copy.Push(cells[i]);
        this.Shown = copy;
        this.Full = false;
        return s;
    }

    // Renders and writes the frame to the terminal.
    public void Present<T>(ref this, ref T t) where T : ITerminal {
        string frame = this.Render();
        if (frame.Len() > 0) t.Write(frame.AsStr());
    }

    // The screen as plain text, a line per row with trailing spaces cut: for tests.
    public string Text(in this) {
        string s = string.New();
        for (u32 y = 0; y < this.R; y++) {
            string line = string.New();
            u32 end = 0;
            for (u32 x = 0; x < this.C; x++) {
                if (this.CharAt(x, y) != ' ' as u32) end = x + 1;
            }
            for (u32 x = 0; x < end; x++) Utf8(ref line, this.CharAt(x, y));
            s.Append(line.AsStr());
            s.AppendByte(10);
        }
        return s;
    }
}

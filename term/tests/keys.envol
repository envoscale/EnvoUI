// envoui.term: the bytes terminals send, decoded into keys; split sequences wait for the
// rest, and a lone Escape is the Escape key only once nothing more is coming.
// expect: a Z Enter Tab Backspace Ctrl+C Space é → |
// expect: Up Down Right Left Home End BackTab |
// expect: Ctrl+Up Alt+Left Shift+Right Delete PageUp PageDown Insert |
// expect: F1 F5 F12 Alt+x |
// expect: |
// expect: Ctrl+Down |
// expect: Escape |
// expect: ctrl ok
use envoui.term;

void Show(ref term.Keys keys, bool final) {
    while (true) {
        term.Key? k = keys.Next(final);
        if (k.IsNone()) break;
        write(1, k.Unwrap().Name().AsStr());
        write(1, " ");
    }
    print("|");
}

term.Keys keys = term.Keys.New();
keys.FeedText("aZ\r\t\x7f\x03 é→");
Show(ref keys, false);
keys.FeedText("\x1b[A\x1b[B\x1b[C\x1b[D\x1b[H\x1b[F\x1b[Z");
Show(ref keys, false);
keys.FeedText("\x1b[1;5A\x1b[1;3D\x1b[1;2C\x1b[3~\x1b[5~\x1b[6~\x1b[2~");
Show(ref keys, false);
keys.FeedText("\x1bOP\x1b[15~\x1b[24~\x1bx");
Show(ref keys, false);
keys.FeedText("\x1b[1;");
Show(ref keys, false);
keys.FeedText("5B\x1b");
Show(ref keys, false);
Show(ref keys, true);
term.Key c = term.Key.Character('c' as u32);
term.Keys k2 = term.Keys.New();
k2.FeedText("\x03q");
term.Key ctrl = k2.Next(false).Unwrap();
if (ctrl.IsCtrl('c' as u32) && !ctrl.IsChar('c' as u32) && k2.Next(false).Unwrap().IsChar('q' as u32) && c.IsChar('c' as u32)) print("ctrl ok");

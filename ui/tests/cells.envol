// envoui in a terminal: a card laid out in cells, focus moved with keys, a checkbox
// toggled with Enter and a button activated with Space.
// expect: ┌──────────────────────────────────┐
// expect: │                                  │
// expect: │ Settings                         │
// expect: │                                  │
// expect: │ Changes apply at once.           │
// expect: │                                  │
// expect: │ [ ] Dark mode                    │
// expect: │                                  │
// expect: │ [x] Sync files                   │
// expect: │                                  │
// expect: │ ──────────────────────────────── │
// expect: │                                  │
// expect: │              [ Cancel ] [ Save ] │
// expect: │                                  │
// expect: └──────────────────────────────────┘
// expect: focus: dark mode
// expect: dark mode on
// expect: focus wraps to save
// expect: save activated
// expect: disabled cancel skipped
// expect: ┌──────────────────────────────────┐
// expect: │                                  │
// expect: │ Settings                         │
// expect: │                                  │
// expect: │ Changes apply at once.           │
// expect: │                                  │
// expect: │ [x] Dark mode                    │
// expect: │                                  │
// expect: │ [x] Sync files                   │
// expect: │                                  │
// expect: │ ──────────────────────────────── │
// expect: │                                  │
// expect: │              [ Cancel ] [ Save ] │
// expect: │                                  │
// expect: └──────────────────────────────────┘
use envoui as ui;
use envoui.term;
use envor.theme;

theme.Theme th = theme.Light();
ui.Tree t = ui.Tree.New();
u32 card = t.Card(t.Root());
t.Text(card, "Settings", ui.TITLE);
t.Text(card, "Changes apply at once.", ui.CAPTION);
u32 dark = t.Checkbox(card, "Dark mode", false);
u32 sync = t.Checkbox(card, "Sync files", true);
t.Divider(card);
u32 row = t.Row(card);
t.Spacer(row);
u32 cancel = t.Button(row, "Cancel", false);
u32 save = t.Button(row, "Save", true);
t.LayoutCells(th, 36, 15);
term.Screen s = term.Screen.New(36, 15);
t.DrawCells(ref s, th);
write(1, s.Text().AsStr());

t.OnKey(term.Key.Of(term.KeyKind.Tab));
if (t.Focused() == dark) print("focus: dark mode");
u32 hit = t.OnKey(term.Key.Of(term.KeyKind.Enter));
if (hit == dark && t.Checked(dark)) print("dark mode on");
t.OnKey(term.Key.Of(term.KeyKind.BackTab));
if (t.Focused() == save) print("focus wraps to save");
if (t.OnKey(term.Key.Character(' ' as u32)) == save) print("save activated");
t.SetEnabled(cancel, false);
t.OnKey(term.Key.Of(term.KeyKind.Up));
if (t.Focused() == sync) print("disabled cancel skipped");
t.DrawCells(ref s, th);
write(1, s.Text().AsStr());

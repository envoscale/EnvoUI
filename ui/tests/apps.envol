// envoui's application components in a terminal: tabs over a split of a file tree and
// a code editor, a text field below; keys open tree items, move the selection, type into
// the editor, and drive the command palette.
// expect:  main.envol ×  lib.envol ×
// expect:  ▸ src        │   1 fn Main() {
// expect:    README.md  │   2     print("hi"); // say it
// expect:    a-very-long│   3 }
// expect:               │
// expect:               │
// expect:               │
// expect: [find                                          ]
// expect: src opened
// expect: selected: main.envol
// expect: opened: main.envol
// expect: edited
// expect:  main.envol ×  lib.envol ×
// expect:  ▾ src        │   1 fn Main()xy {
// expect:      main.envo│   2     print("hi"); // say it
// expect:      lib.envol│   3 }
// expect:    README.md  │
// expect:    a-very-long│
// expect:               │
// expect: [find                                          ]
// expect:  main.envol ×  lib.envol ×
// expect:  ▾ src        │   1 fn Main()xy {
// expect:   ┌──────────────────────────────────────────┐
// expect:   │> fi                                      │
// expect:   │ Find in Files                            │
// expect:   │ Open File                                │
// expect:   └──────────────────────────────────────────┘
// expect: [find                                          ]
// expect: palette chose: Open File
// expect: focus back in the editor
// expect: tab: lib.envol
// expect: tabs left: 1
// expect: submitted: fin
use envoui as ui;
use envoui.edit;
use envoui.term;
use envor.theme;
use alloc.text;

void Show(in ui.Tree t, in theme.Theme th, u32 cols, u32 rows) {
    term.Screen s = term.Screen.New(cols, rows);
    t.DrawCells(ref s, th);
    write(1, s.Text().AsStr());
}

void Say(str a, str b) {
    write(1, a);
    print(b);
}

void Type(ref ui.Tree t, str s) {
    for (usize i = 0; i < s.Len; i++) t.OnKey(term.Key.Character(s[i] as u32));
}

term.Key Ctrl(u32 c) {
    term.Keys keys = term.Keys.New();
    string b = string.New();
    b.AppendByte((c - 'a' as u32 + 1) as u8);
    keys.FeedText(b.AsStr());
    return keys.Next(true).Unwrap();
}

theme.Theme th = theme.Light();
ui.Tree t = ui.Tree.New();
u32 tabs = t.Tabs(t.Root(), true);
t.AddItem(tabs, "main.envol", 0);
t.AddItem(tabs, "lib.envol", 0);
u32 split = t.Split(t.Root(), false);
t.SetRatio(split, 300);
u32 files = t.TreeView(split);
t.AddItem(files, "src", 0);
t.AddItem(files, "main.envol", 1);
t.AddItem(files, "lib.envol", 1);
t.AddItem(files, "README.md", 0);
t.AddItem(files, "a-very-long-file-name.envol", 0);
u32 ed = t.Editor(split, "fn Main() {\n    print(\"hi\"); // say it\n}");
t.SetSyntax(ed, "fn return if", "//");
u32 field = t.TextField(t.Root(), "find");
u32 pal = t.Palette(t.Root());
t.AddItem(pal, "Open File", 0);
t.AddItem(pal, "Save", 0);
t.AddItem(pal, "Find in Files", 0);
t.AddItem(pal, "Format Document", 0);

t.LayoutCells(th, 48, 8);
Show(t, th, 48, 8);

// the tree: focus it, open "src", go down to main.envol
t.SetFocus(files);
u32 r = t.OnKey(term.Key.Of(term.KeyKind.Enter));
if (r == files && t.Action() == ui.ACT_TOGGLE && t.IsOpen(files, 0)) print("src opened");
t.OnKey(term.Key.Of(term.KeyKind.Down));
if (t.Action() == ui.ACT_SELECT) Say("selected: ", t.ItemText(files, t.Item()));
t.OnKey(term.Key.Of(term.KeyKind.Enter));
if (t.Action() == ui.ACT_OPEN) Say("opened: ", t.ItemText(files, t.Item()));

// the editor: type after "fn Main()", break the line, and undo the break
t.LayoutCells(th, 48, 8);
t.SetFocus(ed);
t.Buffer(ed)[0].SetCursor(edit.Pos.At(0, 9));
Type(ref t, "xy");
if (t.Action() == ui.ACT_EDIT) print("edited");
t.OnKey(term.Key.Of(term.KeyKind.Enter));
t.OnKey(Ctrl('z' as u32));
t.LayoutCells(th, 48, 8);
Show(t, th, 48, 8);

// the palette: open it, filter, choose
t.OpenPalette(pal);
Type(ref t, "fi");
t.LayoutCells(th, 48, 8);
Show(t, th, 48, 8);
t.OnKey(term.Key.Of(term.KeyKind.Down));
t.OnKey(term.Key.Of(term.KeyKind.Enter));
if (t.Action() == ui.ACT_OPEN) Say("palette chose: ", t.ItemText(pal, t.Item()));
if (t.Focused() == ed && !t.Visible(pal)) print("focus back in the editor");

// tabs: Right selects the next; a closed tab goes
t.SetFocus(tabs);
t.OnKey(term.Key.Of(term.KeyKind.Right));
if (t.Action() == ui.ACT_SELECT) Say("tab: ", t.ItemText(tabs, t.Item()));
t.RemoveItem(tabs, 0);
Say("tabs left: ", text.Uint(t.ItemCount(tabs) as u64).AsStr());

// the text field: Enter submits
t.SetFocus(field);
t.OnKey(term.Key.Of(term.KeyKind.Backspace));
t.OnKey(term.Key.Of(term.KeyKind.Enter));
if (t.Action() == ui.ACT_OPEN) Say("submitted: ", t.Value(field).AsStr());

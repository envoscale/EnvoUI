// envoui: item icons (SetItemIcon), drawn from shapes so they scale with the text.
namespace envoui;

use envor.gfx;
use envor.font;

// Draws icon in a size by size square at x, y.
void DrawIcon(ref gfx.Canvas c, in font.Font f, u32 icon, i32 x, i32 y, i32 size) {
    i32 s = size;
    if (s < 8) s = 8;
    if (icon == ICON_FOLDER) {
        gfx.Color tan = Rgb(0xD9A84A);
        c.FillRoundedRect(x, y + s * 2 / 16, s * 7 / 16, s * 4 / 16, s / 16 + 1, tan);
        c.FillRoundedRect(x, y + s * 4 / 16, s, s * 10 / 16, s / 8, tan);
        c.FillRect(x + 1, y + s * 6 / 16, s - 2, 1, Rgb(0xF0C66A));
    } else if (icon == ICON_ENVOL) {
        // the EnvoScale mark: a stepped E on blue
        c.FillRoundedRect(x, y, s, s, s * 22 / 100 + 1, Rgb(0x0B66D6));
        gfx.Color white = Rgb(0xFFFFFF);
        i32 stem = Scaled(s, 224);
        i32 top = Scaled(s, 240);
        i32 bar = Scaled(s, 352) - top;
        if (bar < 1) bar = 1;
        i32 w = Scaled(s, 336) - stem;
        if (w < 1) w = 1;
        c.FillRect(x + stem, y + top, w, Scaled(s, 784) - top, white);
        c.FillRect(x + stem, y + top, Scaled(s, 576) - stem, bar, white);
        c.FillRect(x + stem, y + Scaled(s, 456), Scaled(s, 688) - stem, bar, white);
        c.FillRect(x + stem, y + Scaled(s, 784) - bar, Scaled(s, 800) - stem, bar, white);
    } else if (icon == ICON_IMAGE) {
        c.FillRoundedRect(x, y + s / 8, s, s * 12 / 16, s / 8, Rgb(0x2E9C7E));
        c.FillTriangle(x + s / 8, y + s * 12 / 16, x + s * 7 / 16, y + s * 6 / 16, x + s * 12 / 16, y + s * 12 / 16, Rgb(0xE8F6F1));
        c.FillCircle(x + s * 11 / 16, y + s * 6 / 16, s / 10 + 1, Rgb(0xFFE08A));
    } else if (icon == ICON_FILE) {
        Page(ref c, x, y, s, Rgb(0x9AA4B1));
    } else if (icon == ICON_MARKDOWN) {
        Badge(ref c, f, x, y, s, 0x4F7CAC, "M");
    } else if (icon == ICON_JSON) {
        Badge(ref c, f, x, y, s, 0xB8862B, "{}");
    } else if (icon == ICON_BINARY) {
        Badge(ref c, f, x, y, s, 0x6E7781, "01");
    } else if (icon == ICON_CODE) {
        Badge(ref c, f, x, y, s, 0x8E63CE, "<>");
    } else if (icon == ICON_CONFIG) {
        // three sliders
        gfx.Color line = Rgb(0x8A94A3);
        gfx.Color knob = Rgb(0xC5CCD6);
        for (i32 i = 0; i < 3; i++) {
            i32 ly = y + s * (3 + 5 * i) / 16;
            c.FillRect(x + 1, ly, s - 2, s / 16 + 1, line);
            i32 kx = x + s * (4 + 4 * ((i + 1) % 3)) / 16;
            c.FillCircle(kx, ly + s / 32, s / 8 + 1, knob);
        }
    }
}

// v of a 1024 wide drawing, at size s.
i32 Scaled(i32 s, i32 v) => (v * s + 512) / 1024;

// A page with a few lines of text on it.
void Page(ref gfx.Canvas c, i32 x, i32 y, i32 s, gfx.Color color) {
    i32 px = x + s * 2 / 16;
    i32 pw = s * 12 / 16;
    c.FillRoundedRect(px, y, pw, s, s / 10 + 1, color);
    gfx.Color ink = Rgb(0x5F6875);
    for (i32 i = 0; i < 3; i++) {
        i32 ly = y + s * (5 + 3 * i) / 16;
        c.FillRect(px + s * 2 / 16, ly, pw - s * 4 / 16 - (i % 2) * s / 8, s / 16 + 1, ink);
    }
}

// A rounded square in color with a short white label on it.
void Badge(ref gfx.Canvas c, in font.Font f, i32 x, i32 y, i32 s, u32 color, str label) {
    c.FillRoundedRect(x, y, s, s, s / 5 + 1, Rgb(color));
    u32 size = (s * 10 / 16) as u32;
    if (size < 6) size = 6;
    i32 w = f.Measure(label, size);
    i32 lx = x + (s - w) / 2;
    DrawLabel(ref c, f, lx, y, s, label, size, 0xFFFFFF);
}
